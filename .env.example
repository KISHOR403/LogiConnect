# ==============================================================================
# LOGICONNECT ROOT ENVIRONMENT CONFIGURATION
# ==============================================================================

# General
ENVIRONMENT=development
COMPOSE_PROJECT_NAME=logiconnect

# PostgreSQL Database
POSTGRES_DB=logiconnect_db
POSTGRES_USER=logiconnect_user
POSTGRES_PASSWORD=change_me_in_production
POSTGRES_PORT=5432

# Backend (Spring Boot)
BACKEND_PORT=8080
SPRING_PROFILES_ACTIVE=dev
JWT_SECRET=your-256-bit-secret-your-256-bit-secret-jwt-key-here
JWT_EXPIRATION_MS=86400000

# Frontend (Next.js)
FRONTEND_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:8080/api/v1
NEXT_PUBLIC_WS_URL=ws://localhost:8080/ws
