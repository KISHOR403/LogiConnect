# ==============================================================================
# LogiConnect Backend - Environment Variables Configuration
# ==============================================================================

# Application Profile & Server Port
SPRING_PROFILES_ACTIVE=dev
SERVER_PORT=8080

# PostgreSQL Database Configuration
DATABASE_URL=jdbc:postgresql://localhost:5432/logiconnect_db
DATABASE_USERNAME=logiconnect_user
DATABASE_PASSWORD=logiconnect_secure_password_2026

# JWT Security Configuration (Use 256-bit+ secure random secret in production)
JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970
# Access Token expiration in milliseconds (15 minutes = 900000)
JWT_ACCESS_EXPIRATION=900000
# Refresh Token expiration in milliseconds (7 days = 604800000)
JWT_REFRESH_EXPIRATION=604800000

# Frontend URL for CORS (Comma-separated for multiple origins)
APP_FRONTEND_URL=http://localhost:3000,http://localhost:5173
